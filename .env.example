# Paths are relative to the repository root; process environment overrides this file.
MEDIASENSEI_WORKSPACE=.mediasensei-workspace
MEDIASENSEI_API_PORT=8000
MEDIASENSEI_WEB_PORT=3000
# Set only for a custom browser API origin; restart/rebuild web after changing it.
# NEXT_PUBLIC_CORE_API_URL=http://127.0.0.1:8000/api/v1
MEDIASENSEI_CORS_ORIGINS=[]
MEDIASENSEI_MAX_UPLOAD_BYTES=2147483648
MEDIASENSEI_ZIP_MAX_FILES=20000
MEDIASENSEI_ZIP_MAX_TOTAL_BYTES=21474836480

# Allow slower first launches; valid range is 10-1800 seconds.
MEDIASENSEI_STARTUP_TIMEOUT_SECONDS=180

# Optional native executable overrides (otherwise resolved from PATH).
# Configure with: python scripts/configure-media-tools.py --ffmpeg-dir "path/to/bin"
# MEDIASENSEI_FFMPEG=
# MEDIASENSEI_FFPROBE=
# MEDIASENSEI_TESSERACT=
# Windows OCR is used automatically when Tesseract is unavailable.
